# 复制为 .env 后按需修改：cp deploy/.env.example deploy/.env
# .env 不进版本库（见 .gitignore）。生产环境的密钥请全部换成随机值。

APP_ENV=development
HTTP_ADDR=:8080

# --- PostgreSQL ---
# 容器内端口保持 5432；host 侧映射到 5433，避开本机其他项目。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tidings
POSTGRES_PASSWORD=dev_change_me
POSTGRES_DB=tidings
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- MinIO（自建对象存储）---
MINIO_ENDPOINT=minio:9000
# 浏览器能访问到的 MinIO 地址，用于生成预签名直传 URL。
# 必须与 MINIO_ENDPOINT 分开配：预签名 V4 把 Host 算进签名，
# 签完再改写 URL 会让签名失效。留空则退回 MINIO_ENDPOINT。
MINIO_PUBLIC_ENDPOINT=localhost:8093
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=tidings
MINIO_SECRET_KEY=dev_change_me_minio
MINIO_BUCKET=tidings
MINIO_USE_SSL=false
MINIO_PRESIGN_EXPIRY=5m
# 桶开匿名只读：浏览器可直接 GET 对象，图片走 nginx 反代不必签名。
# 安全性依赖 object key 里的 UUID 不可猜 —— 策略只含 GetObject，
# 绝不含 ListBucket，否则全站照片可被枚举。
MINIO_PUBLIC_READ=true

# 直传是跨域请求，CORS 由 MinIO 自己回答（它会回显 Origin）。
# 要收紧的话在 minio 服务的 environment 里加 MINIO_API_CORS_ALLOW_ORIGIN=<站点域名>，
# 别在 nginx 那层加 —— 多一份 Access-Control-Allow-Origin 会让浏览器
# 判定「contains multiple values」而拒掉整个响应。

# 图片对外基地址（nginx 的 /img 入口）。留空则返回相对路径。
MEDIA_BASE_URL=http://localhost:8093

# --- JWT ---
# 至少 32 字节，否则 api 启动时会直接拒绝。
# 生成：openssl rand -base64 48
JWT_SECRET=dev_only_secret_change_me_at_least_32_bytes_long
JWT_ACCESS_TTL=168h
JWT_REFRESH_TTL=2160h
JWT_ISSUER=tidings

# --- 邮箱 + 密码 ---
# 没有验证码、没有找回密码、没有邮箱验证 —— 这三件事都需要一条外发通道，
# 而 MVP 只有 Web Push。忘记密码只能由运营后台重置。
# bcrypt 代价因子，12 约 200–300ms。低于 10 会被 api 拒绝启动。
AUTH_BCRYPT_COST=12
# 只限长度，不强制字符类别 —— 复杂度规则会把用户逼向更难记又没更强的密码
AUTH_MIN_PASSWORD_LEN=8
# 连续密码错误次数上限，超过锁 AUTH_LOCK_DURATION。
# 计数在 Redis，按邮箱与 IP 两个维度分别计。
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_DURATION=30m

# --- Web Push（VAPID）---
# 唯一的触达通道。没有短信，MVP 也没有邮件兜底。
# 生成一次后只备份不轮换 —— 换密钥会让所有已注册的订阅失效。
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID 协议要求的联系地址，形如 mailto:ops@yourdomain.com
VAPID_SUBJECT=

# 静默时段（当地时间，24 小时制）。落在区间内的推送推迟到结束之后再发。
PUSH_QUIET_START=22
PUSH_QUIET_END=9

# --- 匹配与引荐 ---
# 双向匹配分阈值。调引擎时改这个。
MATCH_THRESHOLD=0.55
# 候选集召回上限
MATCH_SCAN_LIMIT=200
# 生成循环周期
INTRO_GEN_INTERVAL=5m
# job_runs 租约时长，必须小于上一项，否则任务会静默停摆。
# api / worker 启动时断言这个关系。
INTRO_GEN_LEASE=4m
# 一次推送最多携带几条
INTRO_BATCH_SIZE=3
# 上海可用池低于此值暂停自动引荐，向用户明示池子在攒人
INTRO_POOL_MIN=100

# --- 运营后台 ---
# 通过 X-Admin-Token 头传入，刻意不复用 Authorization —— 那个头装的是用户 JWT。
# 生产环境用 openssl rand -hex 32 生成。
ADMIN_TOKEN=dev_admin_token
# 管理员邮箱白名单（逗号分隔），仅用于前端判断是否显示后台入口
ADMIN_EMAILS=

TIMEZONE=Asia/Shanghai
