# MinIO 对外入口。
#
# 只做三件事：
#   1. /img/*  —— 图片读取。桶开了匿名只读（仅 GetObject），
#                 这里补长缓存头，让浏览器和后续的 CDN 能缓住。
#   2. /<bucket>/* —— 预签名直传 PUT 的落点，同时负责回 CORS 头。
#   3. 其余一律 404。
#
# 其余一律 404，尤其是 /minio/ 下的管理接口 —— 不能因为要给浏览器
# 开一个图片入口，就把整个 MinIO 的控制面暴露到公网。
#
# Host 头必须原样透传：预签名 V4 把 Host 算进了签名，
# 改写它会让所有直传请求签名校验失败。

# 文件名必须是 default.conf：镜像自带的 default.conf 中 server_name 为
# localhost，会抢在 server_name _ 之前匹配请求。只有同名覆盖才顶得掉。
server {
    listen 80 default_server;
    server_name _;

    # 比后端 8MB 的上限略宽，让超限由后端返回明确错误，
    # 而不是被 nginx 拦成难以理解的 413
    client_max_body_size 10m;

    # 图片可能很大，别让默认缓冲区把大图落到磁盘
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_http_version 1.1;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # --- 管理面：明确拒绝 ---
    location /minio/ {
        return 404;
    }

    # --- 图片读取 ---
    location /img/ {
        limit_except GET HEAD { deny all; }

        rewrite ^/img/(.*)$ /$MINIO_BUCKET/$1 break;
        proxy_pass http://minio:9000;

        # 对象 key 含 UUID，内容一旦写入就不会变，可以放心长缓存。
        # 只用 add_header：再叠一个 expires 指令会发出重复的 Cache-Control。
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        # 不泄露 MinIO 的存在与版本
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header Server;
    }

    # --- 预签名直传落点 ---
    #
    # CORS 完全交给 MinIO 自己回答，这里一个头都不加。
    # MinIO 会回显请求的 Origin，并带 Allow-Credentials / Expose-Headers；
    # 这里再 add_header 一条 Access-Control-Allow-Origin 就会出现两个同名头，
    # 浏览器判定「contains multiple values」后把整个响应拒掉 —— 上传照挂。
    #
    # 唯一必须在这里做的是放行 OPTIONS：limit_except 是「除这些方法以外全都拒」，
    # 漏掉 OPTIONS 的话浏览器预检会在 nginx 就被 403，根本到不了 MinIO，
    # 而且返回的是 nginx 自带页面，看不出跟 CORS 有关。
    location /$MINIO_BUCKET/ {
        limit_except GET HEAD PUT OPTIONS { deny all; }
        proxy_pass http://minio:9000;
    }

    location / {
        return 404;
    }
}
